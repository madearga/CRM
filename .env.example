# Backend CLI selection only. First create and verify a dedicated madearga/ruang
# development deployment, then pin its exact name in config/deployment-target.json.
# Use pnpm backend:check / backend:push; never reuse another project's deploy key.
CONVEX_DEPLOYMENT=dev:replace-with-ruang-deployment
CONVEX_URL=https://replace-with-ruang-deployment.convex.cloud
CONVEX_SITE_URL=https://replace-with-ruang-deployment.convex.site
