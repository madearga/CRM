  {
    "name": "Log call as proposal",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Record a call titled Pricing follow-up for company c1: Budi wants pricing by Friday. Keep that sentence as the note; do not schedule another activity."
      }
    ],
    "expectedCall": [
      {
        "functionName": "propose_activity",
        "arguments": {
          "type": "call",
          "title": "Pricing follow-up",
          "entity": "company",
          "entity_id": "c1",
          "note": {
            "$pattern": "Budi.*Friday"
          }
        },
        "mockOutput": {
          "status": "awaiting_approval",
          "operation_id": "op1",
          "approval_path": "/approvals"
        }
      }
    ]
  },
  {
    "name": "Resolve a deal before proposing stage",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Move the Nusantara renewal to proposal."
      }
    ],
    "expectedCall": [
