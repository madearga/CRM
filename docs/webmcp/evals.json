[
  {
    "name": "Company lookup then key facts",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Show the key facts for Nusantara Logistik."
      }
    ],
    "expectedCall": [
      {
        "functionName": "search_records",
        "arguments": {
          "entity": "company",
          "query": "Nusantara Logistik"
        },
        "mockOutput": {
          "items": [
            {
              "id": "c1",
              "name": "Nusantara Logistik"
            }
          ],
          "page_size": 3,
          "total_count": null,
          "next_cursor": null,
          "has_more": false
        }
      },
      {
        "functionName": "get_record",
        "arguments": {
          "entity": "company",
          "id": "c1"
        },
        "mockOutput": {
          "id": "c1",
          "name": "Nusantara Logistik"
        }
      }
    ]
  },
