  {
    "name": "Mid-chain oversize recovery uses a smaller page",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "List unpaid invoices."
      },
      {
        "role": "model",
        "type": "functioncall",
        "name": "list_invoices",
        "arguments": {
          "status": "unpaid",
          "limit": 5
        }
      },
      {
        "role": "user",
        "type": "functionresponse",
        "name": "list_invoices",
        "response": {
          "result": {
            "error": "Result exceeds the tool budget. Use limit 1; no text was truncated.",
            "code": "OUTPUT_TOO_LARGE"
          }
        }
      }
    ],
    "expectedCall": [
      {
        "functionName": "list_invoices",
        "arguments": {
          "status": "unpaid",
          "limit": 1
        },
        "mockOutput": {
          "items": [],
          "page_size": 3,
          "total_count": null,
          "next_cursor": null,
          "has_more": false
        }
