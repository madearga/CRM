  {
    "name": "Coreference uses IDs supplied by prior result",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Find Nusantara deals."
      },
      {
        "role": "model",
        "type": "functioncall",
        "name": "search_records",
        "arguments": {
          "entity": "deal",
          "query": "Nusantara"
        }
      },
      {
        "role": "user",
        "type": "functionresponse",
        "name": "search_records",
        "response": {
          "result": {
            "items": [
              {
                "id": "d1",
                "title": "Renewal Q1"
              },
              {
                "id": "d2",
                "title": "Warehouse audit"
              }
            ],
            "page_size": 3,
            "total_count": null,
            "next_cursor": null,
            "has_more": false
          }
        }
      },
      {
        "role": "user",
        "type": "message",
        "content": "Open the second one."
      }
    ],
    "expectedCall": [
      {
        "functionName": "open_record",
        "arguments": {
          "entity": "deal",
          "id": "d2"
        },
        "mockOutput": {
          "status": "opened",
          "path": "/deals/d2"
        }
      }
    ]
  },
