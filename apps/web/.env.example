# Copy to .env.local after the dedicated Ruang deployment has been verified.
# These URLs must match config/deployment-target.json and the root .env.local.
NEXT_PUBLIC_CONVEX_URL=https://replace-with-ruang-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://replace-with-ruang-deployment.convex.site
NEXT_PUBLIC_SITE_URL=http://localhost:3005
# Public OAuth identifier, not the Google client secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Server only. Never prefix this key with NEXT_PUBLIC_.
ZAI_API_KEY=
