{
  "name": "crm",
  "version": "0.0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "backend:check": "node scripts/convex-dev.mjs check",
    "backend:dev": "node scripts/convex-dev.mjs watch",
    "backend:push": "node scripts/convex-dev.mjs push",
    "build": "turbo build",
    "dev": "pnpm backend:check && turbo dev",
    "lint": "turbo lint",
    "seed": "node scripts/convex-dev.mjs seed",
    "test": "vitest run --passWithNoTests && pnpm test:safety",
    "test:safety": "node --test scripts/__tests__/*.test.mjs",
    "typecheck": "turbo typecheck"
  },
  "dependencies": {
    "@convex-dev/aggregate": "^0.1.25",
    "@convex-dev/better-auth": "^0.8.9",
    "@convex-dev/rate-limiter": "^0.2.14",
    "@convex-dev/resend": "^0.1.13",
    "@react-email/components": "^0.5.7",
    "@react-email/render": "^1.4.0",
    "better-auth": "1.3.24",
    "convex": "1.48.0",
    "convex-ents": "0.16.0",
    "convex-helpers": "0.1.104",
    "dotenv": "^17.4.2",
    "openai": "^6.49.0",
    "react-email": "^1.10.1",
    "superjson": "^2.2.6",
    "ts-essentials": "10.1.1",
    "type-fest": "^5.10.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "convex-test": "0.0.64",
    "react": "19.1.1",
    "turbo": "^2.11.10",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "dangerouslyAllowAllBuilds": true
  }
}
